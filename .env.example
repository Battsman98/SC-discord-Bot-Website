DISCORD_TOKEN=replace-with-your-discord-bot-token
UEX_API_TOKEN=replace-with-your-uex-app-token
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback
DISCORD_GUILD_ID=
COMMANDS_CHANNEL_ID=
EXEC_STATUS_CHANNEL_ID=
EXEC_ADMIN_ROLE_IDS=
BOT_ADMIN_ROLE_IDS=
BOT_ADMIN_USER_IDS=
CZ_TIMERS_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
# Website deployment revisions are detected automatically on Render. For other hosts,
# set COMMIT_SHA (or GITHUB_SHA) to the deployed Git revision.
COMMIT_SHA=
FEEDBACK_FORUM_CHANNEL_ID=1533026212463775754
COMMAND_CHANNEL_IDS=
BOT_COMMAND_PREFIX=!
DATABASE_PATH=data/bot.sqlite3
# Render overrides this with /var/data/bot.sqlite3 on its persistent disk.
INVENTORY_SCANNER_WORKERS=2
INVENTORY_SCANNER_CAPACITY=4
HTTP_TIMEOUT_SECONDS=15
CACHE_TTL_SECONDS=300
WEB_ADMIN_TOKEN=
WEB_SESSION_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated public origins, e.g. https://example.com,https://www.example.com
TRUSTED_ORIGINS=
MAX_UPLOAD_BYTES=10485760
WEB_RATE_LIMIT_PER_MINUTE=120
DISCORD_RATE_LIMIT_PER_10_SECONDS=8
